PETWISE_HOST=0.0.0.0
PETWISE_PORT=8080
PETWISE_ENV=production
PETWISE_LOG_LEVEL=info
PETWISE_STORAGE_DRIVER=postgres
PETWISE_QUESTIONNAIRE_VERSION=1
PETWISE_SCORING_VERSION=1
PETWISE_CATALOG_VERSION=1
PETWISE_STORAGE_PATH=/app/backend/storage
PETWISE_EXPOSE_ERROR_DETAILS=false
DATABASE_URL=postgres://petwise:petwise@postgres:5432/petwise?sslmode=disable
